APP_ENV=development
APP_NAME=Gheymatyar API
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGIN=http://localhost:3000
MAX_UPLOAD_BYTES=10485760
MAX_WORKBOOK_HEADER_SCAN_ROWS=20
MAX_WORKBOOK_ROWS=50000
MAX_WORKBOOK_COLUMNS=200
MAX_WORKBOOK_SHEETS=20
MAX_XLSX_ARCHIVE_ENTRIES=10000
MAX_XLSX_UNCOMPRESSED_BYTES=104857600
MAX_XLSX_COMPRESSION_RATIO=250
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

POSTGRES_DB=gheymatyar
POSTGRES_USER=gheymatyar
POSTGRES_PASSWORD=change-me-in-real-environments
DATABASE_URL=postgresql+asyncpg://gheymatyar:change-me-in-real-environments@postgres:5432/gheymatyar

REDIS_URL=redis://redis:6379/0

MINIO_ROOT_USER=gheymatyar
MINIO_ROOT_PASSWORD=change-me-in-real-environments
S3_ENDPOINT=http://minio:9000
S3_BUCKET=gheymatyar-files
S3_ACCESS_KEY=gheymatyar
S3_SECRET_KEY=change-me-in-real-environments
