APP_ENV=development
APP_NAME=Gheymatyar API
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql+asyncpg://gheymatyar:local-development-only@localhost:5432/gheymatyar
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=10
AUTH_PUBLIC_REGISTRATION_ENABLED=true
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_SECONDS=604800
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_LIMITER_MAX_ENTRIES=10000
MAX_UPLOAD_BYTES=10485760
MAX_WORKBOOK_HEADER_SCAN_ROWS=20
MAX_WORKBOOK_ROWS=50000
MAX_WORKBOOK_COLUMNS=200
MAX_WORKBOOK_SHEETS=20
MAX_XLSX_ARCHIVE_ENTRIES=10000
MAX_XLSX_UNCOMPRESSED_BYTES=104857600
MAX_XLSX_COMPRESSION_RATIO=250
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

POSTGRES_DB=gheymatyar
POSTGRES_USER=gheymatyar
POSTGRES_PASSWORD=local-development-only

REDIS_URL=redis://redis:6379/0

MINIO_ROOT_USER=gheymatyar
MINIO_ROOT_PASSWORD=local-development-only
S3_ENDPOINT=http://minio:9000
S3_BUCKET=gheymatyar-files
S3_ACCESS_KEY=gheymatyar
S3_SECRET_KEY=local-development-only
