{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/extracted-price-row.schema.json",
  "title": "ExtractedPriceRow",
  "description": "Canonical row produced by any supplier price-list extractor.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_row_number",
    "product_code_raw",
    "product_code_normalized",
    "product_name_raw",
    "product_name_normalized",
    "brand",
    "unit",
    "pack_size",
    "price_irr",
    "availability",
    "availability_raw",
    "notes",
    "raw_row"
  ],
  "properties": {
    "source_row_number": { "type": "integer", "minimum": 1 },
    "product_code_raw": { "type": "string", "minLength": 1 },
    "product_code_normalized": { "type": "string", "minLength": 1, "maxLength": 255 },
    "product_name_raw": { "type": "string", "minLength": 1 },
    "product_name_normalized": { "type": "string", "minLength": 1 },
    "brand": { "type": ["string", "null"] },
    "unit": { "type": ["string", "null"] },
    "pack_size": { "type": ["integer", "null"], "minimum": 1 },
    "price_irr": { "type": "integer", "minimum": 1 },
    "availability_raw": { "type": ["string", "null"] },
    "availability": {
      "type": "string",
      "enum": ["in_stock", "limited", "out_of_stock", "unknown"]
    },
    "notes": { "type": ["string", "null"] },
    "raw_row": { "type": "object" }
  }
}
