{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/extracted-price-row.schema.json",
  "title": "ExtractedPriceRow",
  "description": "Canonical row produced by any supplier price-list extractor.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_row_number",
    "product_code_raw",
    "product_code_normalized",
    "product_name_raw",
    "product_name_normalized",
    "price_irr",
    "availability_status",
    "raw_row",
    "validation_issues"
  ],
  "properties": {
    "source_row_number": { "type": "integer", "minimum": 1 },
    "product_code_raw": { "type": "string", "minLength": 1 },
    "product_code_normalized": { "type": "string", "minLength": 1 },
    "product_name_raw": { "type": "string", "minLength": 1 },
    "product_name_normalized": { "type": "string", "minLength": 1 },
    "brand_raw": { "type": ["string", "null"] },
    "unit_raw": { "type": ["string", "null"] },
    "unit_normalized": { "type": ["string", "null"] },
    "pack_size": { "type": ["integer", "null"], "minimum": 1 },
    "price_irr": { "type": ["integer", "null"], "minimum": 1 },
    "availability_raw": { "type": ["string", "null"] },
    "availability_status": {
      "type": "string",
      "enum": ["in_stock", "limited", "out_of_stock", "unknown"]
    },
    "raw_row": { "type": "object" },
    "validation_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "severity": { "type": "string", "enum": ["ERROR", "WARNING", "INFO"] },
          "field": { "type": ["string", "null"] },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
